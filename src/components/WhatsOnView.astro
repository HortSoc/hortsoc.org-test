---
import { siteAssetPlan } from "../content/site-assets.mjs";
import { withBase } from "../lib/urls.mjs";

const { page, heroKey = "whats_on" } = Astro.props;
const heroAsset = heroKey ? siteAssetPlan.page_heroes?.[heroKey] : null;
const basePath = import.meta.env.BASE_URL;
const sections = Array.isArray(page.sections) ? page.sections : [];

const headingId = (value) =>
  String(value)
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const escapeHtml = (value = "") =>
  String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");

const renderInlineMarkdown = (value = "") =>
  escapeHtml(value)
    .replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, '<a href="$2">$1</a>')
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");

const renderTextMarkdown = (value = "") => {
  const blocks = String(value).trim().split(/\n{2,}/).filter(Boolean);

  return blocks.map((block) => {
    const lines = block.split("\n");
    const isList = lines.every((line) => line.trim().startsWith("- "));

    if (isList) {
      const items = lines
        .map((line) => `<li>${renderInlineMarkdown(line.trim().slice(2))}</li>`)
        .join("");
      return `<ul>${items}</ul>`;
    }

    return `<p>${renderInlineMarkdown(lines.join(" "))}</p>`;
  }).join("");
};
---

<section class="editorial-page">
  {
    heroAsset ? (
      <div class="editorial-hero">
        <img src={withBase(heroAsset.current_path, basePath)} alt={heroAsset.alt} />
      </div>
    ) : null
  }

  <article class="editorial-article">
    <p class="editorial-label">{page.title.toUpperCase()}</p>
    <div class="editorial-content page-content">
      {
        sections.map((section, index) => (
          <section class:list={["whats-on-section", { "with-divider": index > 0 }]}>
            {
              section.title ? (
                section.type === "text" ? (
                  <h3 id={headingId(section.title)}>{section.title}</h3>
                ) : (
                  <h2 id={headingId(section.title)}>{section.title}</h2>
                )
              ) : null
            }
            {
              section.type === "poster" && section.image ? (
                <img
                  class="whats-on-poster"
                  src={withBase(section.image, basePath)}
                  alt={section.alt ?? ""}
                  loading="lazy"
                />
              ) : null
            }
            {
              section.type === "text" && section.body ? (
                <div class="whats-on-text" set:html={renderTextMarkdown(section.body)} />
              ) : null
            }
          </section>
        ))
      }
    </div>
  </article>
</section>

<style>
  .editorial-page {
    display: grid;
    gap: 0;
    background: #ffffff;
  }

  .editorial-hero {
    width: 100%;
    overflow: hidden;
    background: #ffffff;
  }

  .editorial-hero img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 495;
    object-fit: cover;
    object-position: center;
  }

  .editorial-article {
    width: var(--page-shell-width);
    margin: -5.7rem auto 0;
    background: #ffffff;
    padding: 1.6rem var(--page-shell-padding) 0;
    box-sizing: border-box;
  }

  .editorial-label {
    margin: 0 0 1.8rem;
    font-family: var(--font-ui);
    font-size: clamp(1.15rem, 2.1vw, 1.55rem);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5f5f5f;
  }

  .editorial-content {
    max-width: var(--page-copy-width);
    color: var(--page-copy-color);
  }

  .whats-on-section.with-divider {
    border-top: 1px solid rgba(71, 94, 49, 0.18);
    margin-top: 1.8rem;
    padding-top: 1.8rem;
  }

  .whats-on-poster {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1rem auto;
  }

  .whats-on-text :global(p:last-child),
  .whats-on-text :global(ul:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 56rem) {
    .editorial-article {
      width: calc(100% - 2rem);
      margin-top: 0;
      padding: 1.4rem var(--site-inner-padding) 0;
    }
  }
</style>
